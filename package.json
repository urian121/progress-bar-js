{
  "name": "progress-loader-js",
  "version": "1.6.0",
  "description": "Progress Loader JS es un paquete versátil, que te permite mostrar una barra de progreso elegante y altamente personalizable para tus aplicaciones web. Añade un toque de profesionalismo y dinamismo a tu sitio con una implementación sencilla y opciones de personalización flexibles. Ideal para cualquier proyecto que necesite mostrar el progreso de una forma atractiva y eficaz.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "scripts": {
    "build": "vite build",
    "build:clean": "vite build && node scripts/post-build.cjs",
    "dev": "vite --host",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/urian121/progress-loader-js"
  },
  "keywords": [
    "next",
    "nextjs",
    "react",
    "nprogress",
    "progress bar app",
    "progress bar",
    "progress bar js",
    "loader",
    "progress",
    "web development",
    "bar",
    "progress-loader-js",
    "loading",
    "loading spinner",
    "indicador",
    "CSS animations",
    "progress indicator",
    "frontend tools"
  ],
  "author": "Urian Viera",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/urian121/progress-loader-js/issues"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "homepage": "https://github.com/urian121/progress-loader-js#README",
  "devDependencies": {
    "vite": "^5.3.3",
    "vite-plugin-dts": "^3.9.1"
  }
}
